{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2020", "dom"],
    "baseUrl": ".",
    "paths": {
      "@libs/package": ["./package.json"],
      "@libs/environment": ["libs/environment/src/index.ts"],
      "@libs/entity": ["libs/shared/entity/src/index.ts"],
      "@libs/ui": ["libs/shared/ui/src/index.ts"],
      "@libs/profile": ["libs/profile/src/index.ts"],
      "@libs/theme": ["libs/theme/src/index.ts"],
      "@libs/translation": ["libs/shared/translation/src/index.ts"],
      "@libs/analytics": ["./libs/shared/analytics/src/index.ts"],
      "@libs/analytics-firebase": [
        "./libs/shared/analytics-firebase/src/index.ts"
      ],
      "@libs/settings": ["./libs/settings/src/index.ts"],
      "@app/workspace-plugin": ["tools/workspace-plugin/src/index.ts"],
      "@libs/play": ["libs/play/src/index.ts"],
      "@libs/game-ai": ["libs/game/ai/src/index.ts"],
      "@libs/game-core": ["libs/game/core/src/index.ts"],
      "@libs/game-client": ["libs/game/client/src/index.ts"],
      "@libs/auth": ["libs/shared/auth/src/index.ts"],
      "@libs/auth-firebase": ["libs/shared/auth-firebase/src/index.ts"],
      "@libs/game-protocol": ["libs/game/protocol/src/index.ts"],
      "@libs/game-lobby": ["libs/game/lobby/src/index.ts"],
      "@libs/characters": ["libs/characters/src/index.ts"],
      "@libs/character-select": ["libs/shared/character-select/src/index.ts"],
      "@libs/arenas": ["libs/arenas/src/index.ts"],
      "@libs/items": ["libs/items/src/index.ts"],
      "@libs/sounds": ["libs/sounds/src/index.ts"],
      "@libs/audio-settings": ["libs/shared/audio-settings/src/index.ts"],
      "@libs/online": ["libs/online/src/index.ts"],
      "@libs/mounts": ["libs/mounts/src/index.ts"]
    },
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "tmp"]
}
